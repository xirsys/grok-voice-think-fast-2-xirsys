# The public demo uses bring-your-own-key by default. Set XAI_API_KEY only for
# a private deployment where the server should pay for every session.
XAI_API_KEY=
XAI_MODEL=grok-voice-think-fast-2.0
XAI_VOICE=eve
XAI_INSTRUCTIONS=You are a concise, curious voice assistant. Speak naturally and keep answers brief.
XAI_API_BASE=https://api.x.ai
XAI_CLIENT_SECRET_TTL_SECONDS=300

XIRSYS_IDENT=your-xirsys-ident
XIRSYS_SECRET=your-xirsys-secret
XIRSYS_CHANNEL=your-channel-name
XIRSYS_API_BASE=https://global.xirsys.net
XIRSYS_ICE_TTL_SECONDS=60

# Set to the exact HTTPS origin when publicly reachable. Enable TRUST_PROXY only
# when the app is directly behind one trusted reverse proxy, such as Caddy.
PUBLIC_ORIGIN=
TRUST_PROXY=false
BOOTSTRAP_RATE_LIMIT_MAX=10
BOOTSTRAP_RATE_LIMIT_WINDOW_MS=60000

# Bind to localhost when Caddy terminates public HTTPS on the same host.
HOST=0.0.0.0
PORT=3002

# Public deployments should bind WebRTC to a small UDP range and allow that
# same range through the host and cloud firewalls.
# WEBRTC_UDP_PORT_MIN=50000
# WEBRTC_UDP_PORT_MAX=50100
